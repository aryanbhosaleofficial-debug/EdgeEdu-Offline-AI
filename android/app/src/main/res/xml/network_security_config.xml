<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy (PRD §17).

  Cleartext HTTP is permitted so the app can reach the local development sync
  server (tools/sync_server.py), which runs over plain HTTP on the LAN
  (e.g. http://192.168.x.x:8787) — Android 9+ blocks cleartext by default,
  which is what produced the "Cleartext HTTP traffic not permitted" error.

  The public content download already uses HTTPS (GitHub Releases), so this
  does not weaken it. For a PRODUCTION deployment, host sync_server.py behind
  HTTPS and this file can be removed to restore cleartext-blocking.

  Note: Android's <domain> config matches exact hosts, not CIDR ranges, and the
  dev server's LAN IP changes between networks — so a blanket permit is the
  robust choice for this sideloaded debug/testing build.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
