# EdgeEdu backend secrets — this file is gitignored; never commit it.
# Copy of the template: .env.example

# Your MongoDB connection string (e.g. from MongoDB Atlas → Connect → Drivers):
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name the sync server uses (created automatically).
SYNC_DB=edgeedu

# Port the sync server listens on (python tools/sync_server.py).
SYNC_PORT=8787

# The URL the Android app calls — bake it into the APK at build time.
# For a phone on the same WiFi as this PC, use this machine's LAN IP;
# for production, the public HTTPS URL of wherever you deploy sync_server.py.
SYNC_BASE_URL=
